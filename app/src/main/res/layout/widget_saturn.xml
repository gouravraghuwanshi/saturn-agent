<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: an "Ask Saturn" bar; tap opens Saturn with the keyboard up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="16dp">
    <ImageView
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_logo_bg"
        android:contentDescription="@null"
        android:src="@drawable/ic_saturn_foreground" />
    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Ask Saturn…"
        android:textColor="#8E949E"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="#F2B35B"
        android:textSize="12sp" />
</LinearLayout>
