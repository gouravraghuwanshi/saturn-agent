<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: an "Ask Saturn" pill. Tap to type, mic to talk; a chip shows running / waiting tasks. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_glyph" />
        <TextView
            android:id="@+id/widget_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Ask Saturn"
            android:textColor="#C9C5BD"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_chip"
            android:fontFamily="monospace"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:textColor="#F2B35B"
            android:textSize="11sp"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/widget_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_mic_bg"
            android:contentDescription="Talk to Saturn"
            android:padding="10dp"
            android:src="@drawable/widget_mic" />
    </LinearLayout>
</FrameLayout>
